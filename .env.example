# ──────────────────────────────────────────────────────────────────────────────
# EvenNotes – Environment Variables
# Copy this file to .env.local (for local dev) or .env.docker (for Docker) and
# fill in any secrets. .env.example is safe to commit; never commit .env.local
# or .env.docker.
# ──────────────────────────────────────────────────────────────────────────────

# Port on which the API server listens
PORT_API=3001

# Port on which the Vite dev server (web) listens
PORT_WEB=5173

# Absolute or relative path to the workspace directory used for file storage
WORKSPACE_ROOT=./workspace

# Logging level for the API (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# OpenAI API key – REQUIRED to use AI features (leave empty to run in mock mode)
OPENAI_API_KEY=

# LangSmith API key – OPTIONAL, used for LLM tracing/observability
LANGSMITH_API_KEY=

# Enable LangChain/LangSmith tracing — OPTIONAL (true | false)
LANGCHAIN_TRACING_V2=false

# LangChain project name — OPTIONAL, used to group traces in LangSmith
LANGCHAIN_PROJECT=evennotes

# Enable LangSmith tracing — OPTIONAL (true | false)
LANGSMITH_TRACING=false

# LLM provider to use — determines which backend powers AI pipelines
# Possible values: mock | openai
LLM_PROVIDER=mock

# Pipeline execution timeout in milliseconds (default: 30000)
PIPELINE_TIMEOUT_MS=30000

# Maximum number of retries for transient pipeline errors (default: 2)
PIPELINE_MAX_RETRIES=2
