{
  "name": "evennotes",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "docker:up": "docker compose -f infra/docker/compose.yml up --watch",
    "docker:down": "docker compose -f infra/docker/compose.yml down",
    "docker:reset": "docker compose -f infra/docker/compose.yml down -v",
    "docker:logs": "docker compose -f infra/docker/compose.yml logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
